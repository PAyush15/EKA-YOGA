{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yoga-by-krunali",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-31",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yoga-bookings",
      "database_id": "af02d4ef-e4af-4f1d-8864-6d7f2508e841"
    }
  ],
  "vars": {
    "STUDIO_TIMEZONE": "America/Chicago",
    "STUDIO_NAME": "Yoga by Krunali",
    "WHATSAPP_NUMBER": "",
    "PAYMENT_URL": "",
    "PAYMENT_QR_PATH": "",
    "GOOGLE_CLIENT_ID": ""
  }
}

