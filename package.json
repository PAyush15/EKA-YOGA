{
  "name": "yoga-booking-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute yoga-bookings --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute yoga-bookings --remote --file=./schema.sql",
    "seed:local": "wrangler d1 execute yoga-bookings --local --file=./seed.sql",
    "seed:remote": "wrangler d1 execute yoga-bookings --remote --file=./seed.sql"
  },
  "devDependencies": {"wrangler": "^4.45.0"}
}
